# Verify the exact PDFium revision and the upstream release patches.
if(NOT IS_ABSOLUTE "${SOURCE}" OR NOT EXISTS "${SOURCE}/BUILD.gn")
  message(FATAL_ERROR "Invalid PDFium source directory.")
endif()
execute_process(COMMAND "${GIT}" -C "${SOURCE}" rev-parse HEAD OUTPUT_VARIABLE _revision
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _revision STREQUAL "8ca5b735df4263f43c830479b78213854a392c22")
  message(FATAL_ERROR "PDFium must be checked out at pinned revision 8ca5b735df4263f43c830479b78213854a392c22.")
endif()
execute_process(COMMAND "${GIT}" -C "${SOURCE}/build" rev-parse HEAD OUTPUT_VARIABLE _build_revision
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _build_revision STREQUAL "2cd94c0abeada712aeea6906d99021913c9fc28d")
  message(FATAL_ERROR "PDFium's Chromium build checkout does not match the pinned revision.")
endif()
set(_files "BUILD.gn" "public/fpdfview.h" "public/cpp/fpdf_deleters.h" "public/cpp/fpdf_scopers.h" "build/config/clang/BUILD.gn" "buildtools/linux64/gn" "third_party/llvm-build/Release+Asserts/bin/clang")
set(_hashes "21dfd93683afafd2bae56cd153a59f66e026bed6824fc803ee10e6279bf2ce1f" "7fe0ff046ec5a2eaf1642c21076c39737e04d0819bc7265d7c7c33a6b216cb5f" "8020789862e81775e777c3bb6e44eb429eaba6cbf8904bdf2e915fa50d38c47d" "8d2bd2da93bd5564660268203e66576dc82c23bd17157969758ab7c51355c055" "b38dddc9c34d73e2c0b0ae08ff4bee659ed5d3f49b6a34871e8ed7c7814fb471" "34aab9f2f40bae4302c6827df25dff6d7b571483ac0e17797f6c70012937ee5c" "7ef766cd021b0304d7a5273a9614172122df5e4c7b15def3f7ac4ccae75b67e2")
foreach(_index RANGE 0 6)
  list(GET _files ${_index} _file)
  list(GET _hashes ${_index} _expected)
  if(NOT EXISTS "${SOURCE}/${_file}")
    message(FATAL_ERROR "Missing patched PDFium file: ${_file}")
  endif()
  file(SHA256 "${SOURCE}/${_file}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "PDFium file does not match the pinned patched source: ${_file}")
  endif()
endforeach()
execute_process(COMMAND "${GIT}" -C "${SOURCE}" diff HEAD --name-only OUTPUT_VARIABLE _changed
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _changed STREQUAL "BUILD.gn\npublic/cpp/fpdf_deleters.h\npublic/cpp/fpdf_scopers.h\npublic/fpdfview.h")
  message(FATAL_ERROR "PDFium checkout has unexpected tracked modifications.")
endif()
execute_process(COMMAND "${GIT}" -C "${SOURCE}/build" diff HEAD --name-only OUTPUT_VARIABLE _changed
                OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _changed STREQUAL "config/clang/BUILD.gn")
  message(FATAL_ERROR "PDFium's Chromium build checkout has unexpected tracked modifications.")
endif()
foreach(_checkout "${SOURCE}" "${SOURCE}/build")
  execute_process(COMMAND "${GIT}" -C "${_checkout}" ls-files --others --exclude-standard
                  OUTPUT_VARIABLE _untracked OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0 OR NOT _untracked STREQUAL "")
    message(FATAL_ERROR "PDFium checkout has unexpected untracked files: ${_checkout}")
  endif()
endforeach()
